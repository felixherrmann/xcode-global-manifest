{
  "default-configuration": "Release",
  "localizations": { "development": "en" },
  "packages": [
    // Exact and compatible versions
    { "kind": "remote", "repository": "https://example.com/exact.git", "version": { "version": "1.2.3" } },
    { "kind": "remote", "repository": "https://example.com/major.git", "version": { "up-to-next-major-version": "1.2.3" } },
    { "kind": "remote", "repository": "https://example.com/minor.git", "version": { "up-to-next-minor-version": "1.2.3" } },
    /* Both range representations */
    { "kind": "remote", "repository": "https://example.com/range.git", "version": { "version-range": "1.0.0..<2.0.0" } },
    { "kind": "remote", "repository": "https://example.com/prerelease.git", "version": { "version-range-min": "1.0.0-beta.1", "version-range-max": "2.0.0" } },
    { "kind": "remote", "repository": "https://example.com/branch.git", "version": { "branch": "main" } },
    { "kind": "remote", "repository": "https://example.com/revision.git", "version": { "revision": "abcdef" } },
    { "kind": "local", "path": "Packages/Local" },
  ],
  "files": [],
}
